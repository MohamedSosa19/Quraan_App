{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Default": "",
    "Redis": ""
  },
  "Jwt": {
    "Issuer": "quraan-api",
    "Audience": "quraan-app",
