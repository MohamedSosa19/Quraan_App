# -----------------------------------------------------------------------------
# Secrets & local configuration
# -----------------------------------------------------------------------------

# ASP.NET Core user-secrets are stored outside the repo by default, but never
# commit anything that ends up looking like a secret if it lands here.
secrets.json
*.pfx
*.p12
*.key
*.pem
*.crt
*.cer

# Environment / local override config
.env
.env.*
!.env.example
appsettings.Development.json
appsettings.Local.json
appsettings.*.Local.json
**/appsettings.Local.json
**/secrets/

# Azure Key Vault local cache (if any tooling drops one)
.azure/

